<%- include('header', { title: title }) %>
<h1><%= title %></h1>
<% if (errors.length) { %>
  <ul class="errors"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
<% } %>
<form class="entry" method="post" action="<%= action %>">
  <label>Product name
    <input name="product_name" required maxlength="100" value="<%= product.product_name || '' %>">
  </label>
  <label>Category
    <input name="category" required maxlength="50" value="<%= product.category || '' %>">
  </label>
  <label>Price (₹)
    <input name="price" type="number" step="0.01" min="0" required value="<%= product.price !== undefined ? product.price : '' %>">
  </label>
  <label>Quantity in stock
    <input name="quantity" type="number" step="1" min="0" required value="<%= product.quantity !== undefined ? product.quantity : '' %>">
  </label>
  <label>Reorder level
    <input name="reorder_level" type="number" step="1" min="0" required value="<%= product.reorder_level !== undefined ? product.reorder_level : 10 %>">
    <small>Reorder when stock falls to this number or below.</small>
  </label>
  <div class="row">
    <button type="submit">Save product</button>
    <a href="/products">Cancel</a>
  </div>
</form>
<%- include('footer') %>
